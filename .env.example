# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Proteção de custos
MAX_REQUESTS_PER_RUN=300
REQUEST_CONCURRENCY=4

# Cache local
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# Enriquecimento (Place Details)
MIN_RATING_ENRICHMENT=4.0
MIN_REVIEWS_ENRICHMENT=10

# Leads qualificados
MIN_QUALIFIED_RATING=4.3
MIN_QUALIFIED_REVIEWS=20
MIN_QUALIFIED_SCORE=60
